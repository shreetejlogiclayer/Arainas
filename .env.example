# ==================== EMAIL CONFIGURATION ====================
# EmailJS Configuration for ARAINA Contact Form
# Sign up at https://www.emailjs.com/ to get your credentials.

VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# ==================== BACKEND API ====================
# Backend server URL for portal APIs

VITE_API_URL=http://localhost:5000

# ==================== STORAGE CONFIGURATION ====================
# For uploading live photos and user assets
# Options: none, s3, supabase, cloudinary

VITE_STORAGE_PROVIDER=none
VITE_STORAGE_BUCKET=your_bucket_name
VITE_STORAGE_REGION=your_region
VITE_STORAGE_PUBLIC_URL=https://your-storage.example.com

# ==================== PAYMENT CONFIGURATION ====================
# Payment gateway provider
# Options: none, razorpay, cashfree, phonepe

VITE_PAYMENT_PROVIDER=none

# ==================== AADHAAR CONFIGURATION ====================
# Aadhaar verification provider
# Options: mock (for development), production (real UIDAI verification)

VITE_AADHAAR_PROVIDER=mock

# ==================== PORTAL CONFIGURATION ====================
# Portal application URL

VITE_PORTAL_URL=http://localhost:5173/portal

