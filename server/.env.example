# ==================== DATABASE ====================
# For MySQL on the same Hostinger account, use 127.0.0.1.
# URL-encode special characters in the database password.
DATABASE_URL="mysql://DB_USER:URL_ENCODED_PASSWORD@127.0.0.1:3306/DB_NAME"

# ==================== SERVER ====================
NODE_ENV=development
PORT=5001

# ==================== SECRETS ====================
# Replace both with independent random values (at least 32 characters) in production.
SESSION_SECRET=replace-with-at-least-32-random-characters
JWT_SECRET=replace-with-another-32-random-characters

# ==================== FRONTEND ====================
FRONTEND_URL=http://localhost:5173
PORTAL_URL=http://localhost:5173/portal

# ==================== EMAIL ====================
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=care@arainas.com
SMTP_PASS=replace-with-hostinger-email-password
EMAIL_FROM=care@arainas.com

# ==================== STORAGE ====================
STORAGE_PROVIDER=none
# In production, set this to a persistent writable path outside the deploy directory.
USER_UPLOAD_DIR=./uploads
# S3
# AWS_S3_BUCKET=
# AWS_S3_REGION=
# AWS_S3_ACCESS_KEY=
# AWS_S3_SECRET_KEY=

# ==================== PAYMENT ====================
PAYMENT_PROVIDER=none
# PayU Hosted Checkout. Keep the merchant salt on the backend only.
# Set PAYMENT_PROVIDER=payu after configuring all four values below.
PAYU_ENV=test
PAYU_KEY=
PAYU_SALT=
# Public HTTPS URL of this backend endpoint (also used for success and failure).
PAYU_CALLBACK_URL=

# ==================== AADHAAR ====================
# mock is development-only; configure an authorized provider before production.
AADHAAR_PROVIDER=none
